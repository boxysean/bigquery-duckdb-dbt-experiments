# dbt v2 build artifacts and the local DuckDB file. `dbt init` in dbt-oss 2.0.5
# generates the first five lines; the rest are this project's own.
dbt_packages/
dbt_internal_packages/
logs/
# ... except the raw logs of the value-parity run, which are evidence and committed
# (analyses/transport_{a,b}/logs/ were force-added for the same reason).
!analyses/value_parity/logs/
target/
.env

# Local DuckDB database (`make clean` also removes it)
dev.duckdb
dev.duckdb.wal

# Managed by `uv sync`
.venv/
__pycache__/

# dbt writes this per-user anonymous usage id into the project directory
.user.yml

# Generated by `make parity` (scripts/parity.py). Regenerated on every run; the
# run's copy is attached to the card / pasted into the PR rather than committed.
parity-report.md
parity-report.json
