# b23: row order with ORDER BY temp (and what the sort does to the file count)
# sql: analyses/transport_b/sql/b23_row_order_order_by.sql
# wall (job insert + poll) 5.51s  http 200  job job_ZRVBUADAdHxIurzZi3Z2ok2obqnN
# statementType EXPORT_DATA  state DONE
# expected to fail: False
# objects under gs://coreychimpbot-experiments/transport_b/b23/: 1

-- b23: row order, made deterministic with ORDER BY. Same table, same wildcard, same
-- columns — the only change is the sort. This is the export shape a reproducible
-- pipeline needs, and it is the one bigquery_extract (b25) cannot express.
EXPORT DATA OPTIONS(
  uri='gs://coreychimpbot-experiments/transport_b/b23/c-*.parquet',
  format='PARQUET', overwrite=true) AS
SELECT stn, year, mo, da, temp
FROM `bigquery-public-data.noaa_gsod.gsod2023`
WHERE temp IS NOT NULL
ORDER BY temp

