-- T04: the working form -- SCOPE follows the data, billing_project follows the money.
LOAD bigquery;
CREATE SECRET bq_pub (TYPE bigquery, SCOPE 'bq://bigquery-public-data',
                      SERVICE_ACCOUNT_PATH '__SA_PATH__');
SELECT count(*) AS usa_names_rows
FROM bigquery_scan('bigquery-public-data.usa_names.usa_1910_2013',
                   billing_project := 'coreychimpbot');

