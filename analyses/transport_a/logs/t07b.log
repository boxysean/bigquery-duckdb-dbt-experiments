# command: /usr/bin/time -v -o /home/hermes/.hermes/profiles/bruno/cache/scratch/transport_a/t07b.time /home/hermes/.local/bin/duckdb -init /dev/null :memory: <<'SQL'
# (SQL as run, after placeholder substitution; __SA_PATH__ stands for the
#  service-account key path, which is never written to this log)

-- T07b: predicted vs billed bytes for ONE query shape.
-- The /* t07b 20260927T152417Z */ comment makes the GoogleSQL text unique to this run, so
-- the real query cannot be answered from BigQuery's query-results cache and the two
-- numbers in this log are comparable. Without a fresh marker, a repeat of the same
-- query reports cache_hit = true and 0 bytes processed (that is visible in t07).
-- NOTE: the dry-run result has to be read with SELECT * -- see t18.
LOAD bigquery;
CREATE SECRET bq_pub (TYPE bigquery, SCOPE 'bq://bigquery-public-data',
                      SERVICE_ACCOUNT_PATH '__SA_PATH__');
CREATE SECRET bq_me (TYPE bigquery, SCOPE 'bq://coreychimpbot',
                     SERVICE_ACCOUNT_PATH '__SA_PATH__');
SET bq_debug_show_queries = true;
.timer on

.print '--- (a) dry run: bytes BigQuery says this shape will process'
SELECT * FROM bigquery_query('bigquery-public-data',
  'SELECT /* t07b 20260927T152417Z */ COUNT(*) AS n FROM `bigquery-public-data.usa_names.usa_1910_2013` WHERE year = 2000',
  dry_run := true, billing_project := 'coreychimpbot');

.print '--- (b) the real run of the same shape'
SELECT * FROM bigquery_query('bigquery-public-data',
  'SELECT /* t07b 20260927T152417Z */ COUNT(*) AS n FROM `bigquery-public-data.usa_names.usa_1910_2013` WHERE year = 2000',
  billing_project := 'coreychimpbot');

.print '--- (c) the newest query jobs in the billing project: the first row is (b)'
SELECT job_id, job_type, state, bytes_processed, creation_time
FROM bigquery_jobs('coreychimpbot') WHERE job_type = 'QUERY'
ORDER BY creation_time DESC LIMIT 5;

