# b04: EXPORT DATA an 8.0 GB table: what the 1 GB-per-file limit does
# sql: analyses/transport_b/sql/b04_export_split.sql
# wall (job insert + poll) 8.66s  http 200  job job_3nUW9myVPobXV9yz74pIuKAKClxH
# statementType EXPORT_DATA  state DONE
# expected to fail: False
# objects under gs://coreychimpbot-experiments/transport_b/b04/: 59

-- b04: the wildcard/split demonstration. 58,937,715 rows / 8.0 GB of BigQuery
-- logical storage. BigQuery caps one exported file at 1 GB, so this cannot come back
-- as a single object; the job's exportDataStatistics.fileCount and the object sizes in
-- the bucket are the evidence for what actually happened.
EXPORT DATA OPTIONS(
  uri='gs://coreychimpbot-experiments/transport_b/b04/citibike-*.parquet',
  format='PARQUET',
  overwrite=true) AS
SELECT * FROM `bigquery-public-data.new_york_citibike.citibike_trips`

