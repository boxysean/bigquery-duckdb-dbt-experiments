-- b18: the nested/repeated export read back. This is the half of the type story that CSV
-- cannot carry at all: arrays, structs, arrays of structs and nested structs.
CREATE SECRET tb_http (TYPE http, BEARER_TOKEN '__TOKEN__');
DESCRIBE SELECT * FROM read_parquet(['https://storage.googleapis.com/coreychimpbot-experiments/transport_b/b13/types-000000000000.parquet']);
SELECT * FROM read_parquet(['https://storage.googleapis.com/coreychimpbot-experiments/transport_b/b13/types-000000000000.parquet']) ORDER BY id;

