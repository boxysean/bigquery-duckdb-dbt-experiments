-- b18b: BIGNUMERIC (76 significant digits) and GEOGRAPHY, read back from b13b's Parquet.
CREATE SECRET tb_http (TYPE http, BEARER_TOKEN '__TOKEN__');
DESCRIBE SELECT * FROM read_parquet(['https://storage.googleapis.com/coreychimpbot-experiments/transport_b/b13b/edge-000000000000.parquet']);
SELECT * FROM read_parquet(['https://storage.googleapis.com/coreychimpbot-experiments/transport_b/b13b/edge-000000000000.parquet']) ORDER BY id;

